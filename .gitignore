# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnpm-store
**/.pnpm-store/
/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# python
__pycache__/
*.py[cod]
/data/*.db
/data/*.db-*
/data/**/*.db
/data/**/*.db-*
!/data/info_service.db

# next.js
/.next/
**/.next/
/.vinext/
**/.vinext/
/.vite/
**/.vite/
/out/
**/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
**/dist/
/.wrangler/
**/.wrangler/
/outputs/
/work/

